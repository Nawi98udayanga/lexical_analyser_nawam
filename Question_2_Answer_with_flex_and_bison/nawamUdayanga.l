%{
#include <stdio.h>
#include "y.tab.h" // Include the header file generated by Bison
#include <string.h> // Include for strdup
extern int location; // Declare location as extern
%}

LETTER [a-zA-Z]
DIGIT [0-9]
NONZERO [1-9]
ALPHANUM ({LETTER}|{DIGIT}|_)
ID {LETTER}{ALPHANUM}*
INTEGER (0|{NONZERO}{DIGIT}*)
FRACTION (\.{DIGIT}*{NONZERO}|\.0)
EXPONENT ([eE][+\-]?{INTEGER})
FLOAT ({INTEGER}{FRACTION}{EXPONENT}?|{INTEGER}{EXPONENT}|{INTEGER}{FRACTION})
INVALID_FLOAT {DIGIT}+\.[0-9]*\.{DIGIT}*

%%

\n          { location++; }

"("           { printf("%-15s\t%-20s\t%d\n", yytext, "PUNCT_LEFTPARAN", location); return PUNCT_LEFTPARAN; }
")"           { printf("%-15s\t%-20s\t%d\n", yytext, "PUNCT_RIGHTPARAN", location); return PUNCT_RIGHTPARAN; }
"{"           { printf("%-15s\t%-20s\t%d\n", yytext, "PUNCT_LEFTCURL", location); return PUNCT_LEFTCURL; }
"}"           { printf("%-15s\t%-20s\t%d\n", yytext, "PUNCT_RIGHTCURL", location); return PUNCT_RIGHTCURL; }
"["           { printf("%-15s\t%-20s\t%d\n", yytext, "PUNCT_LEFTSQBR", location); return PUNCT_LEFTSQBR; }
"]"           { printf("%-15s\t%-20s\t%d\n", yytext, "PUNCT_RIGHTSQBR", location); return PUNCT_RIGHTSQBR; }
";"           { printf("%-15s\t%-20s\t%d\n", yytext, "PUNCT_SEMICOLON", location); return PUNCT_SEMICOLON; }
","           { printf("%-15s\t%-20s\t%d\n", yytext, "PUNCT_COMMA", location); return PUNCT_COMMA; }
"."           { printf("%-15s\t%-20s\t%d\n", yytext, "PUNCT_DOT", location); return PUNCT_DOT; }
":"           { printf("%-15s\t%-20s\t%d\n", yytext, "PUNCT_COLON", location); return PUNCT_COLON; }
"->"          { printf("%-15s\t%-20s\t%d\n", yytext, "PUNCT_IMPLIES", location); return PUNCT_IMPLIES; }
"+"           { printf("%-15s\t%-20s\t%d\n", yytext, "OP_ADD", location); return OP_ADD; }
"-"           { printf("%-15s\t%-20s\t%d\n", yytext, "OP_SUB", location); return OP_SUB; }
"*"           { printf("%-15s\t%-20s\t%d\n", yytext, "OP_MUL", location); return OP_MUL; }
"/"           { printf("%-15s\t%-20s\t%d\n", yytext, "OP_DIV", location); return OP_DIV; }
"="           { printf("%-15s\t%-20s\t%d\n", yytext, "OP_ASSIGNMENT", location); return OP_ASSIGNMENT; }
"=="          { printf("%-15s\t%-20s\t%d\n", yytext, "OP_EQUAL", location); return OP_EQUAL; }
"<>"          { printf("%-15s\t%-20s\t%d\n", yytext, "OP_NOTEQUAL", location); return OP_NOTEQUAL; }
"<"           { printf("%-15s\t%-20s\t%d\n", yytext, "OP_LESSTHAN", location); return OP_LESSTHAN; }
">"           { printf("%-15s\t%-20s\t%d\n", yytext, "OP_GREATERTHAN", location); return OP_GREATERTHAN; }
"<="          { printf("%-15s\t%-20s\t%d\n", yytext, "OP_LESSTHANOREQUAL", location); return OP_LESSTHANOREQUAL; }
">="          { printf("%-15s\t%-20s\t%d\n", yytext, "OP_GREATERTHANOREQUAL", location); return OP_GREATERTHANOREQUAL; }
"or"          { printf("%-15s\t%-20s\t%d\n", yytext, "OP_OR", location); return OP_OR; }
"and"         { printf("%-15s\t%-20s\t%d\n", yytext, "OP_AND", location); return OP_AND; }
"not"         { printf("%-15s\t%-20s\t%d\n", yytext, "OP_NOT", location); return OP_NOT; }
"else"        { printf("%-15s\t%-20s\t%d\n", yytext, "RES_ELSE", location); return RES_ELSE; }
"float"       { printf("%-15s\t%-20s\t%d\n", yytext, "RES_FLOAT", location); return RES_FLOAT; }
"func"        { printf("%-15s\t%-20s\t%d\n", yytext, "RES_FUNC", location); return RES_FUNC; }
"if"          { printf("%-15s\t%-20s\t%d\n", yytext, "RES_IF", location); return RES_IF; }
"impl"        { printf("%-15s\t%-20s\t%d\n", yytext, "RES_IMPL", location); return RES_IMPL; }
"inherits"    { printf("%-15s\t%-20s\t%d\n", yytext, "RES_INHERITS", location); return RES_INHERITS; }
"integer"     { printf("%-15s\t%-20s\t%d\n", yytext, "RES_INTEGER", location); return RES_INTEGER; }
"let"         { printf("%-15s\t%-20s\t%d\n", yytext, "RES_LET", location); return RES_LET; }
"private"     { printf("%-15s\t%-20s\t%d\n", yytext, "RES_PRIVATE", location); return RES_PRIVATE; }
"public"      { printf("%-15s\t%-20s\t%d\n", yytext, "RES_PUBLIC", location); return RES_PUBLIC; }
"read"        { printf("%-15s\t%-20s\t%d\n", yytext, "RES_READ", location); return RES_READ; }
"return"      { printf("%-15s\t%-20s\t%d\n", yytext, "RES_RETURN", location); return RES_RETURN; }
"self"        { printf("%-15s\t%-20s\t%d\n", yytext, "RES_SELF", location); return RES_SELF; }
"struct"      { printf("%-15s\t%-20s\t%d\n", yytext, "RES_STRUCT", location); return RES_STRUCT; }
"then"        { printf("%-15s\t%-20s\t%d\n", yytext, "RES_THEN", location); return RES_THEN; }
"var"         { printf("%-15s\t%-20s\t%d\n", yytext, "RES_VAR", location); return RES_VAR; }
"void"        { printf("%-15s\t%-20s\t%d\n", yytext, "RES_VOID", location); return RES_VOID; }
"while"       { printf("%-15s\t%-20s\t%d\n", yytext, "RES_WHILE", location); return RES_WHILE; }

{ID}       { printf("%-15s\t%-20s\t%d\n", yytext, "IDENTIFIER", location); yylval.str = strdup(yytext); return IDENTIFIER; }
{INTEGER}  { printf("%-15s\t%-20s\t%d\n", yytext, "INTEGER_NUMBER", location); yylval.num = atoi(yytext); return INTEGER_NUMBER; }
{FLOAT}    { printf("%-15s\t%-20s\t%d\n", yytext, "FLOAT_NUMBER", location); yylval.fnum = atof(yytext); return FLOAT_NUMBER; }

[ \t\n]+   ; /* ignore whitespace */
"//"[^\n]* ; /* ignore inline comments */
"/*"(.|\n)*?"*/" ; /* ignore block comments */

. { fprintf(stderr, "Warning: Unrecognized character '%s' at location %d\n", yytext, location); }
{NONZERO}+{LETTER}+ { fprintf(stderr, "Warning: Invalid identifier '%s' starting with a digit at location %d\n", yytext, location); } 
{INVALID_FLOAT} { fprintf(stderr, "Error: Invalid floating-point literal '%s' at location %d\n", yytext, location); }
"/*"([^*]|(\*+[^*/]))*$ { fprintf(stderr, "Error: Unclosed block comment at location %d\n", location); }

%%

int yywrap() {
    return 1;
}
